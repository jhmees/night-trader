# Copy to .env (gitignored). Never commit real values (design §11.1, RT-5).
FRED_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ANTHROPIC_API_KEY=

# Live trading is double-gated: this env var AND the --live CLI flag must both
# be set, and trades above limits.live_confirm_threshold_usd still require
# --confirm (design §11.4 rule 5).
NIGHTTRADER_LIVE=0
